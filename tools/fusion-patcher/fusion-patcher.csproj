<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool: produces the server-side copy of Fusion.Runtime.dll that OpenPak.Server.Fusion
       loads (see docs/fusion-shared-server.md). Never commit its input or output DLLs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FusionPatcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Mono.Cecil" Version="0.11.6" /></ItemGroup>
</Project>
