<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless stand-in for Unity's "UnityEngine" facade assembly, so Fusion.Runtime.dll (which
    references UnityEngine for math, unsafe memory, JSON and a few inert engine types) can be
    loaded and run in this plain .NET server. Original code — no Unity or Photon material.
    See docs/fusion-shared-server.md.
  -->
  <PropertyGroup>
    <AssemblyName>UnityEngine</AssemblyName>
    <RootNamespace>UnityEngine</RootNamespace>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0660;CS0661;CS0067;CS8632;CS0659;CS1591</NoWarn>
  </PropertyGroup>

</Project>
